# Build & Framework binaries (TOO LARGE FOR GITHUB)
Qt/
build/
build-linux/
.vscode/

# Build artifacts (compiled output only - these patterns are global, so they
# would also hide any legitimately-committed .exe/.dll if one is ever added;
# use `git add -f` in that case)
*.exe
*.dll
*.pdb
*.obj
*.ilk
*.exp
*.lib

# Logs
aqtinstall.log
*.log

# Visual reference mockups
welcome_flow.png

# Secrets & credentials (never commit)
oauth.json
secrets/

# Dependencies
node_modules/

# Playwright (generated)
tests/playwright/playwright-report/
tests/playwright/test-results/
